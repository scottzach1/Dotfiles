# ghostty — default terminal (kitty kept for the dropdown scratchpad).
# Follows the desktop light/dark preference (which darkman flips) automatically.
theme = light:catppuccin-latte,dark:catppuccin-mocha
font-family = FiraCode Nerd Font
font-size = 11
background-opacity = 0.95
window-padding-x = 8
window-padding-y = 8
cursor-style = block
confirm-close-surface = false
