# mako — Catppuccin Latte (light). darkman copies this to ./config on day.
font=FiraCode Nerd Font 10
width=380
height=120
margin=10
padding=10
border-size=2
border-radius=8
default-timeout=5000
icons=1
max-icon-size=48

background-color=#eff1f5
text-color=#4c4f69
border-color=#8839ef
progress-color=over #ccd0da

[urgency=low]
border-color=#9ca0b0

[urgency=high]
border-color=#d20f39
default-timeout=0
