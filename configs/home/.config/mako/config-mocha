# mako — Catppuccin Mocha (dark). darkman copies this to ./config on night.
font=FiraCode Nerd Font 10
width=380
height=120
margin=10
padding=10
border-size=2
border-radius=8
default-timeout=5000
icons=1
max-icon-size=48

background-color=#1e1e2e
text-color=#cdd6f4
border-color=#cba6f7
progress-color=over #313244

[urgency=low]
border-color=#6c7086

[urgency=high]
border-color=#f38ba8
default-timeout=0
